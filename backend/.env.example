# ─── Odoo connection (server-only — never prefix with NEXT_PUBLIC_) ─────────────
# Base HOST of your Odoo instance (no trailing slash, no /odoo, no /web).
# Wrong:  …dev.odoo.com/odoo   ← browser login URL; breaks JSON-RPC → empty site
# Right:  …dev.odoo.com
# Staging: https://aptusinfotech-staging-35193445.dev.odoo.com
ODOO_URL=https://aptusinfotech-staging-35193445.dev.odoo.com

# Database name (must match the Odoo instance above)
ODOO_DB=aptusinfotech-staging-35193445

# Login of a dedicated Odoo API user (least privilege — not a full admin).
# Grant read (and write only if seeding scripts need it) on website.page,
# website.menu, and ir.ui.view for the target website. Prefer API key auth.
ODOO_USER=editor@example.com

# API key — generate at: Odoo → top-right avatar → Preferences
#            → Account Security → API Keys → New API Key
# IMPORTANT: copy it immediately — Odoo only shows it once.
# Rotate if this value was ever committed, shared, or logged.
# Odoo DB itself is not exposed by this app — only HTTPS JSON-RPC to ODOO_URL.
ODOO_API_KEY=

# ─── Optional Odoo settings ─────────────────────────────────────────────────────
# Which Odoo website record to use (default: 1)
ODOO_WEBSITE_ID=1

# Career applications: pushed into Odoo Recruitment as hr.applicant when Odoo is
# configured (best-effort — failures are logged and flagged in the HR email, the
# candidate still succeeds). The ODOO_USER above needs create rights on
# hr.applicant + ir.attachment; a dedicated Recruitment-only user is safest.
# Optional: pin the pipeline stage. Leave unset and Odoo uses the default first
# stage. Find the id at Settings → Recruitment → Stages (inspect the record URL).
# ODOO_APPLICANT_STAGE_ID=1
#
# Quote / contact forms also create crm.lead (best-effort alongside the sales
# email). Grant the same ODOO_USER create access on crm.lead (CRM app not
# read-only). Title format: "Request a Quote – {product}".
#
# Contact Form Studio fields on res.partner (auto-discovered if unset).
# ODOO_ENQUIRY_REF_FIELD=x_studio_x_enquiry_reference
# ODOO_ENQUIRY_SOURCE_FIELD=x_studio_x_website_enquiry
# ODOO_ENQUIRY_SOURCE_VALUE=Contact Form
# Optional Contacts tag id for "Website Enquiry" (else search/create by name).
# ODOO_ENQUIRY_CATEGORY_ID=12
# Optional crm.lead Studio field for Request Quote ref (also stored in Notes).
# ODOO_QUOTE_REF_FIELD=x_studio_quote_reference
# Optional Studio field on crm.lead for Individual vs Company ("individual"|"company")
# ODOO_CRM_CUSTOMER_TYPE_FIELD=x_studio_customer_type
#
# Multi-company routing: Software pages file the lead under the SOFTWARE
# company, ELV/Infrastructure pages under INFRA — no frontend picker needed.
# Find company ids at Settings → Companies (inspect the record URL).
# Required for CRM sync of quote requests: crm.ts fails loud (throws, caught
# by reportCrmLeadFailure which alerts the sales inbox) if a quote's category
# has no matching *_COMPANY_ID here, rather than silently filing it under the
# wrong company. Leave unset only if you don't need multi-company routing.
# ODOO_SOFTWARE_COMPANY_ID=1
# ODOO_ELV_COMPANY_ID=2
#
# Optional finer-grained pipeline placement (sales team + stage), same
# category-specific-then-legacy priority as company_id above. Safe to leave
# unset — team/stage isn't fail-loud like company_id, Odoo just assigns its
# default team. Falls back to legacy ODOO_CRM_TEAM_ID / ODOO_CRM_STAGE_ID.
# ODOO_CRM_SOFTWARE_TEAM_ID=
# ODOO_CRM_SOFTWARE_STAGE_ID=
# ODOO_CRM_ELV_TEAM_ID=
# ODOO_CRM_ELV_STAGE_ID=
# ODOO_CRM_TEAM_ID=
# ODOO_CRM_STAGE_ID=
#
# Backfill existing website contacts (dry-run, then --apply):
#   npx --yes tsx --env-file=.env.local scripts/backfill-website-enquiry-fields.ts
#   npx --yes tsx --env-file=.env.local scripts/backfill-website-enquiry-fields.ts --apply

# ISR revalidation TTL in seconds (default: 60)
ODOO_REVALIDATE=300

# Secret for POST /api/revalidate — required in all deployed environments.
# Must match Odoo system parameter nextjs.token (aptus_nextjs_sync module).
# Generate: openssl rand -hex 32
# Rotate together on backend, frontend, and Odoo whenever compromised.
ODOO_REVALIDATE_TOKEN=

# URL of the deployed frontend (used to fan-out revalidation after Odoo changes).
# Must be HTTPS in production. Leave empty to skip fan-out.
APTUS_FRONTEND_URL=http://localhost:3000

# ─── Next.js public vars (safe to expose to the browser) ───────────────────────
# Absolute public URL of this Next.js site (used for canonical URLs & OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — set TRUST_PROXY=true only behind a reverse proxy that strips
# client-supplied X-Forwarded-For (Vercel sets VERCEL=1 automatically).
# TRUST_PROXY=true

# Set to true to log mapped CMS page structure in the backend process.
# Never use NEXT_PUBLIC_* for this — keep dumps off the client bundle.
DEBUG_ODOO=false

# REQUIRED for GET /api/odoo in non-production. Fail-closed if unset.
# Pass via header: X-Debug-Token: <value>  (never via query string)
# Generate: openssl rand -hex 32
ODOO_DEBUG_TOKEN=

# ─── Email via Resend (server-only — never prefix with NEXT_PUBLIC_) ───────────
# Create an API key at https://resend.com/api-keys
# Replace re_xxxxxxxxx with your real API key (do not commit the real value).
RESEND_API_KEY=re_xxxxxxxxx

# Must be a verified domain/sender in Resend (or use onboarding@resend.dev for tests).
FROM_EMAIL="Aptus Infotech <no-reply@aptusinfotech.com>"

# Careers applications → HR inbox
HR_EMAIL=anaghawork24@gmail.com

# Contact / quote form inbox (fallback when category-specific inbox unset)
CONTACT_TO_EMAIL=anaghawork24@gmail.com

# Category routing for quote leads (optional — falls back to CONTACT_TO_EMAIL)
SOFTWARE_SALES_EMAIL=challapranavi@gmail.com
ELV_SALES_EMAIL=challapranavi@gmail.com

# Optional legacy aliases (still honored if HR_EMAIL / FROM_EMAIL unset):
# CAREER_TO_EMAIL=anaghawork24@gmail.com
# SMTP_FROM="Aptus Infotech <no-reply@aptusinfotech.com>"

# ─── Rate limiting (Upstash Redis — required on Vercel multi-instance) ───────
# Create a free Redis DB at https://console.upstash.com → REST API credentials.
# Without these, counters stay in-process and do NOT share across serverless
# instances (attackers can rotate instances to bypass limits).
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Durable archive of career applications (written before the HR email so a
# lost/spam-filtered email never loses an application). Contains applicant PII.
# Target is picked automatically:
#   • BLOB_READ_WRITE_TOKEN set → Vercel Blob (see production example). Preferred
#     on serverless. The Blob store MUST be created with PRIVATE access.
#   • otherwise → local disk at APPLICATION_ARCHIVE_DIR (defaults to
#     ./data/applications; use a mounted volume on a persistent host).
# APPLICATION_ARCHIVE_DIR=/var/data/aptus-applications
