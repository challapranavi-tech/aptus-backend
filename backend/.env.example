# ─── Odoo connection (server-only — never prefix with NEXT_PUBLIC_) ─────────────
# Base URL of your Odoo instance (no trailing slash)
ODOO_URL=https://your-odoo-instance.odoo.com

# Database name
ODOO_DB=your-odoo-database

# Login of a dedicated Odoo API user (least privilege — not a full admin).
# Grant read (and write only if seeding scripts need it) on website.page,
# website.menu, and ir.ui.view for the target website. Prefer API key auth.
ODOO_USER=editor@example.com

# API key — generate at: Odoo → top-right avatar → Preferences
#            → Account Security → API Keys → New API Key
# IMPORTANT: copy it immediately — Odoo only shows it once.
# Rotate if this value was ever committed, shared, or logged.
# Odoo DB itself is not exposed by this app — only HTTPS JSON-RPC to ODOO_URL.
ODOO_API_KEY=

# ─── Optional Odoo settings ─────────────────────────────────────────────────────
# Which Odoo website record to use (default: 1)
ODOO_WEBSITE_ID=1

# ISR revalidation TTL in seconds (default: 60)
ODOO_REVALIDATE=60

# Secret for POST /api/revalidate — required in all deployed environments.
# Must match Odoo system parameter nextjs.token (aptus_nextjs_sync module).
# Generate: openssl rand -hex 32
# Rotate together on backend, frontend, and Odoo whenever compromised.
ODOO_REVALIDATE_TOKEN=

# URL of the deployed frontend (used to fan-out revalidation after Odoo changes).
# Must be HTTPS in production. Leave empty to skip fan-out.
APTUS_FRONTEND_URL=http://localhost:3000

# ─── Next.js public vars (safe to expose to the browser) ───────────────────────
# Absolute public URL of this Next.js site (used for canonical URLs & OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — set TRUST_PROXY=true only behind a reverse proxy that strips
# client-supplied X-Forwarded-For (Vercel sets VERCEL=1 automatically).
# TRUST_PROXY=true

# Set to true to log mapped CMS page structure in the backend process.
# Never use NEXT_PUBLIC_* for this — keep dumps off the client bundle.
DEBUG_ODOO=false

# REQUIRED for GET /api/odoo in non-production. Fail-closed if unset.
# Pass via header: X-Debug-Token: <value>  (never via query string)
# Generate: openssl rand -hex 32
ODOO_DEBUG_TOKEN=

# ─── SMTP (server-only) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aptus Infotech <no-reply@aptusinfotech.com>"
CONTACT_TO_EMAIL=info@aptusinfotech.com
CAREER_TO_EMAIL=hr@aptusinfotech.com
