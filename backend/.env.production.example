# Production / Vercel — copy keys into Vercel → Settings → Environment Variables
# (Production scope). See docs/odoo-environments.md for staging vs prod matrix.
#
# Do NOT commit real secrets. Generate fresh values for production.
# All secrets below are server-only — never use the NEXT_PUBLIC_ prefix for them.
#
# Rotation checklist (OWASP):
#  1. ODOO_API_KEY — revoke old key in Odoo, issue new, update Vercel
#  2. ODOO_REVALIDATE_TOKEN — openssl rand -hex 32; sync frontend + Odoo nextjs.token
#  3. SMTP_PASS — rotate at the mail provider
#  4. Leave ODOO_DEBUG_TOKEN unset in production (route is disabled by NODE_ENV)

# ─── Odoo connection (production instance) ─────────────────────────────────────
ODOO_URL=https://your-production-instance.odoo.com
ODOO_DB=your-production-database
ODOO_USER=editor@example.com
ODOO_API_KEY=

ODOO_WEBSITE_ID=1
ODOO_REVALIDATE=60

# Required — /api/revalidate returns 503 if unset. Rotate with Odoo nextjs.token.
ODOO_REVALIDATE_TOKEN=

# Frontend origin for revalidate fan-out (HTTPS). Also used for CORS allowlist.
APTUS_FRONTEND_URL=https://your-production-domain.com

# ─── Next.js public vars ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aptus Infotech <no-reply@aptusinfotech.com>"
CONTACT_TO_EMAIL=info@aptusinfotech.com
CAREER_TO_EMAIL=hr@aptusinfotech.com

# ─── Debug (leave unset / false in production) ───────────────────────────────
DEBUG_ODOO=false
# Do not set ODOO_DEBUG_TOKEN in production — /api/odoo returns 403 via NODE_ENV.
