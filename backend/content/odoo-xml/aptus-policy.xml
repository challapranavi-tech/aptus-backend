<t t-name="website.aptus-policy">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty">
            <section class="s_embed_code pt0 pb0 o_colored_level" data-snippet="s_embed_code" data-name="Aptus Policy Content">
                <div class="s_embed_code_embedded o_not_editable container-fluid"><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
.aptus-page { font-family: 'Poppins', sans-serif; color: #1a1a2e; }
.aptus-page {
            font-family: 'Poppins', sans-serif;
            background: #ffffff;
            color: #1a1a2e;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            width: 90%;
            margin: 0 auto;
        }

        
        /* ========== PAGE BANNER ========== */
        .page-banner {
            width: 100%;
            height: auto;
            margin-bottom: 50px;
        }
        .page-banner img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* ========== SECTION STYLES ========== */
        .badge {
            color: #1352a3;
            font-weight: 600;
            letter-spacing: 1px;
            margin-bottom: 10px;
            display: inline-block;
        }
        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }
        .section-title h2 {
            font-size: 36px;
            color: #1a1a2e;
        }
        .section-title h2 span {
            color: #1352a3;
        }

        /* Policy Content */
        .policy-content {
            background: #f8fafc;
            padding: 50px;
            border-radius: 20px;
            margin-bottom: 50px;
        }
        .modus-operandi {
            text-align: center;
            margin-bottom: 40px;
        }
        .modus-operandi h3 {
            font-size: 28px;
            color: #1352a3;
            margin-bottom: 20px;
        }
        .infographic {
            text-align: center;
            margin: 30px 0;
        }
        .infographic img {
            max-width: 100%;
            border-radius: 12px;
        }

        /* Vertical Policy Items */
        .policy-vertical {
            display: flex;
            flex-direction: column;
            gap: 40px;
            margin: 40px 0;
        }
        .policy-vertical-item {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            align-items: center;
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: 0.3s;
        }
        .policy-vertical-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .policy-vertical-text {
            flex: 2;
        }
        .policy-vertical-text p {
            color: #475569;
            line-height: 1.7;
            font-size: 16px;
        }
        .policy-vertical-image {
            flex: 1;
            text-align: center;
        }
        .policy-vertical-image img {
            max-width: 100%;
            border-radius: 12px;
            max-height: 200px;
            object-fit: cover;
        }

        /* Alternating layout */
        .policy-vertical-item:nth-child(even) {
            flex-direction: row-reverse;
        }

        .privacy-policy {
            background: #e8edf3;
            padding: 40px;
            border-radius: 20px;
            margin-top: 30px;
        }
        .privacy-policy h4 {
            font-size: 24px;
            color: #1352a3;
            margin-bottom: 20px;
        }
        .privacy-policy p {
            color: #475569;
            line-height: 1.7;
        }

        /* Strategic Alliances Section */
        .alliances-section {
            background: #f8fafc;
            padding: 60px 0;
            text-align: center;
            margin-top: 50px;
            border-radius: 20px;
        }
        .alliances-section h2 {
            font-size: 36px;
            margin-bottom: 40px;
        }
        .alliances-section h2 span {
            color: #1352a3;
        }
        .alliances-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 25px;
            margin-bottom: 25px;
        }
        .alliance-logo {
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
            width: 110px;
            height: 80px;
        }
        .alliance-logo:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }
        .alliance-logo img {
            max-width: 80px;
            max-height: 50px;
            object-fit: contain;
        }

        /* Contact Form Section */
        .contact-form-section {
            background: #003049;
            color: white;
            padding: 60px 0;
            text-align: center;
            border-radius: 20px;
            margin: 50px 0;
        }
        .contact-form-section h2 {
            font-size: 36px;
            margin-bottom: 10px;
        }
        .contact-form-section .subtitle {
            margin-bottom: 30px;
            opacity: 0.9;
        }
        .contact-form {
            max-width: 800px;
            margin: 0 auto;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            flex: 1;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: none;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }
        .form-group textarea {
            resize: vertical;
        }
        .submit-btn {
            background: #1352a3;
            color: white;
            border: none;
            padding: 14px 40px;
            border-radius: 40px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .submit-btn:hover {
            background: #0e3d7a;
            transform: scale(1.02);
        }

        
        /* ========== RESPONSIVE ========== */
        @media (max-width: 900px) {
            /* Mobile submenu fix */
            .dropdown-submenu &gt; .dropdown-subcontent {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                box-shadow: none;
                padding-left: 20px;
                display: none;
            }
            .dropdown-submenu.active &gt; .dropdown-subcontent {
                display: block;
            }
            
            .dropdown-large .dropdown-content { column-count: 1; left: 0; min-width: auto; }
            .policy-vertical-item {
                flex-direction: column !important;
                text-align: center;
            }
            .form-row { flex-direction: column; }
            .section-title h2 { font-size: 28px; }
            .policy-content {
                padding: 25px;
            }
            .alliances-grid { gap: 15px; }
            .alliance-logo { width: 90px; height: 70px; }
        }
</style>
