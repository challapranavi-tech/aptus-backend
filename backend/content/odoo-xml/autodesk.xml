                    <a class="sw-btn" href="#Form">Request a Quote</a>
                    <a class="sw-btn sw-btn--green" href="#Form">Renew Subscription</a>
                    <a class="sw-btn sw-btn--sky" href="#products">Browse Products</a>
                </div>
            </div>
        </section>
        <section class="sw-section" id="products">
            <div class="container">
                <div class="sw-section-head">
                    <h2>Popular Autodesk Products</h2>
                    
                </div>
                <div class="sw-card-grid sw-card-grid--product">
            <div class="sw-card">
              <div class="sw-card-img"><img src="https://aptusinfotech.com/wp-content/uploads/2025/08/Autocad.png" alt="AutoCAD" loading="lazy"/></div>
