<t t-name="website.career">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty">
            <section class="s_embed_code pt0 pb0 o_colored_level" data-snippet="s_embed_code" data-name="Career Content">
                <div class="s_embed_code_embedded o_not_editable container-fluid"><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<style>
.aptus-page { font-family: 'Poppins', sans-serif; color: #1a1a2e; }
.aptus-page {
            font-family: 'Poppins', sans-serif;
            background: #ffffff;
            color: #1a1a2e;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            width: 90%;
            margin: 0 auto;
        }

        
        /* ========== PAGE STYLES ========== */
        .page-header {
            background: linear-gradient(135deg, #0b2b3b 0%, #1352a3 100%);
            color: white;
            padding: 60px 0;
            text-align: center;
            margin-bottom: 50px;
        }
        .page-header h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }
        .page-header p {
            font-size: 18px;
            max-width: 800px;
            margin: 0 auto;
            opacity: 0.9;
        }

        /* Career Content */
        .career-intro {
            text-align: center;
            max-width: 800px;
            margin: 0 auto 50px;
            color: #475569;
            line-height: 1.8;
        }
        .career-intro p {
            margin-bottom: 15px;
        }

        /* Application Form */
        .application-form {
            background: #f8fafc;
            padding: 50px;
            border-radius: 20px;
            margin-bottom: 50px;
        }
        .application-form h2 {
            text-align: center;
            font-size: 32px;
            color: #1352a3;
            margin-bottom: 30px;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            flex: 1;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #1e293b;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            transition: 0.2s;
        }
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #1352a3;
            box-shadow: 0 0 0 3px rgba(19, 82, 163, 0.1);
        }
        .form-group input[type="file"] {
            padding: 10px;
            background: white;
        }
        .required-star {
            color: #e53e3e;
        }
        .submit-btn {
            background: #1352a3;
            color: white;
            border: none;
            padding: 14px 50px;
            border-radius: 40px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            display: block;
            margin: 0 auto;
        }
        .submit-btn:hover {
            background: #0e3d7a;
            transform: scale(1.02);
        }

        
        /* ========== RESPONSIVE ========== */
        @media (max-width: 900px) {
            /* Mobile submenu fix */
            .page-header h1 { font-size: 32px; }
            .page-header p { font-size: 16px; }
        }
</style>
<div class="aptus-page aptus-page--career">
<div class="page-header">
    <div class="container">
        <h1>Join Our Team at Aptus Infotech</h1>
        <p>Join Our Growing Team! We're always looking for passionate, innovative, and driven individuals to join our team.</p>
    </div>
</div><div class="container">
    <div class="career-intro">
        <p>At Aptus Infotech, we believe that our employees are the foundation of our success. We are always on the lookout for passionate, innovative, and driven individuals to join our team. If you're looking to be part of a company that encourages creativity, collaboration, and continuous growth, then Aptus Infotech might be the place for you.</p>
    </div>

    <div class="application-form">
        <h2>Become a part of Aptus Infotech</h2>
        <form method="post" enctype="multipart/form-data" action="#">
            <div class="form-row">
                <div class="form-group">
                    <label>First Name <span class="required-star">*</span></label>
                    <input type="text" name="first_name" placeholder="First Name" required=""/>
                </div>
                <div class="form-group">
                    <label>Last Name <span class="required-star">*</span></label>
                    <input type="text" name="last_name" placeholder="Last Name" required=""/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Job Title <span class="required-star">*</span></label>
                    <input type="text" name="job_title" placeholder="For which position are you applying?" required=""/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>City <span class="required-star">*</span></label>
                    <input type="text" name="city" placeholder="City" required=""/>
                </div>
                <div class="form-group">
                    <label>State/Province <span class="required-star">*</span></label>
                    <input type="text" name="state" placeholder="State/Province" required=""/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Email Address <span class="required-star">*</span></label>
                    <input type="email" name="email" placeholder="Email Address" required=""/>
                </div>
                <div class="form-group">
                    <label>Country <span class="required-star">*</span></label>
                    <input type="text" name="country" placeholder="Country" required=""/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Phone Number <span class="required-star">*</span></label>
                    <input type="tel" name="phone" placeholder="Phone Number" required=""/>
                </div>
                <div class="form-group">
                    <label>LinkedIn Profile <span class="required-star">*</span></label>
                    <input type="url" name="linkedin" placeholder="Profile link" required=""/>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>How did you hear about us? <span class="required-star">*</span></label>
                    <select name="heard_from" required="">
                        <option value="" disabled="" selected="">Select an option</option>
                        <option value="Media">Media</option>
                        <option value="Referrals">Referrals</option>
                        <option value="Social Media">Social Media</option>
                        <option value="Events">Events</option>
                        <option value="LinkedIn">LinkedIn</option>
                        <option value="Indeed">Indeed</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Upload Your CV (PDF, DOC, DOCX)</label>
                    <input type="file" name="cv" accept=".pdf,.doc,.docx"/>
                    <small style="color: #64748b; font-size: 12px;">Max file size: 5MB</small>
                </div>
            </div>
            <button type="submit" class="submit-btn">Submit Application</button>
        </form>
    </div>
</div>

    <section class="contact-form-section">
        <div class="container">
            <h2>Have questions? We can help</h2>
            <div class="subtitle">Our experts can help you find the right solutions for your business.</div>
            <form class="contact-form" action="/contactus" method="post">
                <div class="form-row">
                    <div class="form-group">
                        <label>First Name *</label>
                        <input type="text" name="first_name" required="required"/>
                    </div>
                    <div class="form-group">
                        <label>Last Name *</label>
                        <input type="text" name="last_name" required="required"/>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" name="email" placeholder="name@mail.com" required="required"/>
                    </div>
                    <div class="form-group">
                        <label>Phone *</label>
                        <input type="tel" name="phone" placeholder="e.g, +968 0000 0000" required="required"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>Message</label>
                    <textarea name="message" rows="4" placeholder="Message"/>
                </div>
                <button type="submit" class="submit-btn">Submit Now</button>
            </form>
        </div>
    </section>
</div></div>
            </section>
        </div>
    </t>
</t>
