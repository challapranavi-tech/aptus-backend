<style>
.aptus-page { font-family: 'Poppins', sans-serif; color: #1a1a2e; }
.aptus-page {
            font-family: 'Poppins', sans-serif;
            background: #ffffff;
            color: #1a1a2e;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            width: 90%;
            margin: 0 auto;
        }

        
        /* ========== PAGE BANNER ========== */
        .page-banner {
            width: 100%;
            height: auto;
            margin-bottom: 50px;
        }
        .page-banner img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* ========== SECTION STYLES ========== */
        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }
        .section-title h1 {
            font-size: 48px;
            color: #1a1a2e;
        }

        /* Pillars Grid */
        .pillars-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 60px;
            justify-content: center;
        }
        .pillar-card {
            flex: 1;
            min-width: 250px;
            text-align: center;
            padding: 40px 25px;
            background: #f8fafc;
            border-radius: 20px;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .pillar-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .pillar-icon {
            font-size: 60px;
            margin-bottom: 20px;
        }
        .pillar-card h3 {
            font-size: 24px;
            color: #1352a3;
            margin-bottom: 15px;
        }
        .pillar-card p {
            color: #475569;
            line-height: 1.6;
        }

        /* Winning Together Content */
        .winning-content {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            align-items: center;
            background: #f8fafc;
            border-radius: 20px;
            padding: 50px;
            margin-bottom: 60px;
        }
        .winning-text {
            flex: 1;
        }
        .winning-text p {
            color: #475569;
            line-height: 1.8;
            margin-bottom: 20px;
        }
        .winning-image {
            flex: 1;
            text-align: center;
        }
        .winning-image img {
            width: 100%;
            max-width: 500px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        /* Strategic Alliances Section */
        .alliances-section {
            background: #f8fafc;
            padding: 60px 0;
            text-align: center;
            margin-top: 50px;
            border-radius: 20px;
        }
        .alliances-section h2 {
            font-size: 36px;
            margin-bottom: 40px;
        }
        .alliances-section h2 span {
            color: #1352a3;
        }
        .alliances-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 25px;
            margin-bottom: 25px;
        }
        .alliance-logo {
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
            width: 110px;
            height: 80px;
        }
        .alliance-logo:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }
        .alliance-logo img {
            max-width: 80px;
            max-height: 50px;
            object-fit: contain;
        }

        /* Contact Form Section */
        .contact-form-section {
            background: #003049;
            color: white;
            padding: 60px 0;
            text-align: center;
            border-radius: 20px;
            margin: 50px 0;
        }
        .contact-form-section h2 {
            font-size: 36px;
            margin-bottom: 10px;
        }
        .contact-form-section .subtitle {
            margin-bottom: 30px;
            opacity: 0.9;
        }
        .contact-form {
            max-width: 800px;
            margin: 0 auto;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            flex: 1;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: none;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }
        .form-group textarea {
            resize: vertical;
        }
        .submit-btn {
            background: #1352a3;
            color: white;
            border: none;
            padding: 14px 40px;
            border-radius: 40px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .submit-btn:hover {
            background: #0e3d7a;
            transform: scale(1.02);
        }

        
        /* ========== RESPONSIVE ========== */
        @media (max-width: 900px) {
            /* Mobile submenu fix */
            .dropdown-submenu &gt; .dropdown-subcontent {
                position: static;
                opacity: 1;
                visibility: visible;
                transform: none;
                box-shadow: none;
                padding-left: 20px;
                display: none;
            }
            .dropdown-submenu.active &gt; .dropdown-subcontent {
                display: block;
            }
            
            .dropdown-large .dropdown-content { column-count: 1; left: 0; min-width: auto; }
            .pillars-grid { flex-direction: column; }
            .winning-content { flex-direction: column; text-align: center; padding: 30px; }
            .form-row { flex-direction: column; }
            .section-title h1 { font-size: 32px; }
            .alliances-grid { gap: 15px; }
            .alliance-logo { width: 90px; height: 70px; }
        }
</style>
