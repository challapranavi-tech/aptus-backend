<style>
.aptus-page { font-family: 'Poppins', sans-serif; color: #1a1a2e; }
.aptus-page {
            font-family: 'Poppins', sans-serif;
            background: #ffffff;
            color: #1a1a2e;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            width: 90%;
            margin: 0 auto;
        }

        
        /* ========== PAGE BANNER ========== */
        .page-banner {
            width: 100%;
            height: auto;
            margin-bottom: 50px;
        }
        .page-banner img {
            width: 100%;
            height: auto;
        }

        /* ========== SECTION STYLES ========== */
        .section-title {
            text-align: center;
            margin-bottom: 40px;
        }
        .section-title h1 {
            font-size: 36px;
            color: #1a1a2e;
        }

        /* Why Aptus - Vertical Layout */
        .why-vertical {
            display: flex;
            flex-direction: column;
            gap: 40px;
            margin-bottom: 50px;
        }
        .why-vertical-item {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            align-items: center;
            background: #f8fafc;
            border-radius: 20px;
            overflow: hidden;
            transition: 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .why-vertical-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .why-vertical-content {
            flex: 1;
            padding: 35px;
        }
        .why-vertical-content h3 {
            font-size: 28px;
            color: #1352a3;
            margin-bottom: 20px;
        }
        .why-vertical-content ul {
            list-style: none;
            padding-left: 0;
        }
        .why-vertical-content ul li {
            padding: 10px 0;
            position: relative;
            padding-left: 30px;
            color: #475569;
            line-height: 1.6;
        }
        .why-vertical-content ul li::before {
            content: "✓";
            color: #1352a3;
            font-weight: bold;
            font-size: 18px;
            position: absolute;
            left: 0;
        }
        .why-vertical-image {
            flex: 1;
            min-height: 300px;
        }
        .why-vertical-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Alternating layout */
        .why-vertical-item:nth-child(even) {
            flex-direction: row-reverse;
        }

        /* Policy Section */
        .policy-section {
            background: #e8edf3;
            padding: 40px;
            border-radius: 20px;
            margin: 50px 0;
            text-align: center;
        }
        .policy-section h3 {
            font-size: 24px;
            color: #1352a3;
            margin-bottom: 20px;
        }
        .policy-section p {
            color: #475569;
            line-height: 1.7;
        }
        .policy-logo {
            margin-top: 30px;
        }
        .policy-logo img {
            max-width: 100%;
            border-radius: 12px;
        }

        /* Strategic Alliances Section */
        .alliances-section {
            background: #f8fafc;
            padding: 60px 0;
            text-align: center;
            margin-top: 50px;
        }
        .alliances-section h2 {
            font-size: 36px;
            margin-bottom: 40px;
        }
        .alliances-section h2 span {
            color: #38b6ff;
        }
        .alliances-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }
        .alliance-logo {
            width: 100px;
            height: 100px;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
        }
        .alliance-logo:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }
        .alliance-logo img {
            max-width: 100%;
            max-height: 70px;
        }

        /* Contact Form Section */
        .contact-form-section {
            background: #003049;
            color: white;
            padding: 60px 0;
            text-align: center;
        }
        .contact-form-section h2 {
            font-size: 36px;
            margin-bottom: 30px;
        }
        .contact-form {
            max-width: 800px;
            margin: 0 auto;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }
        .form-group {
            flex: 1;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: none;
            border-radius: 8px;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
        }
        .form-group textarea {
            resize: vertical;
        }
        .submit-btn {
            background: #1352a3;
            color: white;
            border: none;
            padding: 14px 40px;
            border-radius: 40px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }
        .submit-btn:hover {
            background: #0e3d7a;
            transform: scale(1.02);
        }

        
        /* ========== RESPONSIVE ========== */
        @media (max-width: 900px) {
            /* MOBILE */
@media (max-width: 900px) {
