# ─── Odoo connection ────────────────────────────────────────────────────────────
# Base URL of your Odoo instance (no trailing slash)
ODOO_URL=https://aptusinfotech-staging-33910464.dev.odoo.com

# Database name — for Odoo.com Online, this is the subdomain portion
ODOO_DB=aptusinfotech-staging-33910464

# Login email of the Odoo user that owns the API key
ODOO_USER=admin@aptusinfotech.com

# API key — generate at: Odoo → top-right avatar → Preferences
#            → Account Security → API Keys → New API Key
# IMPORTANT: copy it immediately — Odoo only shows it once.
ODOO_API_KEY=

# ─── Optional Odoo settings ─────────────────────────────────────────────────────
# Which Odoo website record to use (default: 1)
ODOO_WEBSITE_ID=1

# ISR revalidation TTL in seconds (default: 60)
ODOO_REVALIDATE=60

# ─── Next.js public vars ────────────────────────────────────────────────────────
# Absolute public URL of this Next.js site (used for canonical URLs & OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Debug ───────────────────────────────────────────────────────────────────────
# Set to true to log raw Odoo responses, mapped pages, and section structure.
# Only active in development — has no effect in production.
NEXT_PUBLIC_DEBUG_ODOO=false

# Optional secret token to protect the /api/odoo debug route.
# If set, every request must include ?token=<value> or X-Debug-Token: <value>.
# Leave empty to allow unauthenticated access (dev only — never set in prod).
ODOO_DEBUG_TOKEN=
