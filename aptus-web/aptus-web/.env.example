# Copy to .env.local and fill in values for production.

ODOO_BASE_URL=https://aptusinfotech-staging-33910464.dev.odoo.com
ODOO_DB=aptusinfotech-staging-33910464
ODOO_API_KEY=your-api-key-from-odoo-account-security

# RS256 JWT keys (PEM format — use \n for newlines in .env)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Legacy HS256 fallback (deprecated — use RS256 keys above)
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetimes (seconds)
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

# AES-256 key for PII field encryption at rest (min 32 characters)
PII_ENCRYPTION_KEY=change-me-to-32-char-minimum-key!!

# true = demo (accounts only in .data/)
# false = live Odoo (new registrations create Contacts in Odoo)
AUTH_DEMO_MODE=true

# Optional: Odoo boolean field on res.partner to block portal without archiving
# ODOO_PORTAL_ENABLED_FIELD=x_portal_enabled

# Backend team inbox for new portal software orders
ORDER_NOTIFICATION_EMAIL=support@aptusinfotech.com
# Base URL for links in customer emails (server-side only — do not use NEXT_PUBLIC_ for secrets)
# PORTAL_BASE_URL=https://aptusinfotech.com
# Optional from address for SMTP (defaults to SMTP user)
# ORDER_NOTIFICATION_FROM=portal@aptusinfotech.com

# Email delivery — configure SMTP (preferred) or rely on Odoo outgoing mail.mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=portal@aptusinfotech.com

# Admin API access (comma-separated emails for order status updates)
# ADMIN_EMAILS=admin@aptusinfotech.com

# Days before renewal to mark subscription as Expiring Soon (default 30)
# SUBSCRIPTION_EXPIRING_DAYS=30

# Renewal reminder emails sent at these day thresholds before expiry
# RENEWAL_REMINDER_DAYS=90,60,30,15,7,3,1

# Stripe (server-only — never NEXT_PUBLIC_; used in src/app/api/payments/* only)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Shared OTP + rate-limit store (required in production on Vercel/serverless)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# After ODOO_API_KEY is set and AUTH_DEMO_MODE=false:
#   npm run migrate:auth  — hash passwords into .data/portal-accounts.json
#   npm run sync:odoo     — link accounts to Odoo partner ids

# Set true to log full Odoo JSON-2 request/response payloads in the dev server console
# ODOO_DEBUG=true

# Headless CMS — home page from Odoo website.page (url="/")
# ODOO_CMS_HOME_URL=/
# ODOO_CMS_WEBSITE_ID=7
# ODOO_CMS_HOME_PAGE_ID=226
# ODOO_CMS_REVALIDATE_SEC=300
# Dev default is 0 (no cache). Set 300 in production.
# ODOO_CMS_INCLUDE_UNPUBLISHED=true
# ODOO_CMS_PREFER_PUBLISHED=true

# Structured homepage sections JSON field on website.page (Phase 4)
# ODOO_CMS_HOMEPAGE_JSON_FIELD=x_homepage_sections_json
# npm run cms:setup-homepage-field   — create field on Odoo (once)
# npm run cms:seed-homepage            — seed default JSON to ODOO_CMS_HOME_PAGE_ID

# Structured ELV page sections JSON field on website.page (Phase 4)
# ODOO_CMS_ELV_JSON_FIELD=x_elv_sections_json
# ODOO_CMS_ELV_PAGE_URL=/elv-solutions
# npm run cms:setup-elv-field   — create field on Odoo (once)
# npm run cms:seed-elv          — seed default JSON to /elv-solutions page

# Autodesk product platform (aptus.autodesk.product model)
# ODOO_AUTODESK_PRODUCT_MODEL=aptus.autodesk.product
# Install: odoo-modules/aptus_autodesk_product (optional — deferred)
# npm run cms:export-autodesk-json       — export marketing JSON templates
# npm run cms:seed-autodesk-inner-pages  — push JSON to website.page (active approach)

# Multi-company Odoo: set if portal partners have no company_id (optional)
# ODOO_DEFAULT_COMPANY_ID=1

# Force CRM pipeline team when auto-detection picks the wrong one (optional)
# ODOO_CRM_TEAM_ID=1

# CRM lead Notes field for portal order text (Odoo UI label is usually "Notes"; default: description)
# ODOO_CRM_LEAD_NOTES_FIELD=description

# Portal order routing (discovered from staging — adjust if teams change)
# ODOO_SOFTWARE_CRM_TEAM_ID=5
# ODOO_SOFTWARE_COMPANY_ID=2
# ODOO_ELV_CRM_TEAM_ID=6
# ODOO_ELV_COMPANY_ID=3

# Subscription sync — staging Odoo uses 3_progress and Studio license field
ODOO_SUBSCRIPTION_ACTIVE_STATES=progress,3_progress
ODOO_LICENSE_FIELD=x_studio_line_serial_number

# Portal order routing (staging)
ODOO_SOFTWARE_CRM_TEAM_ID=5
ODOO_SOFTWARE_COMPANY_ID=2
# CRM "New" stage id for portal software orders (staging default: 1)
# ODOO_CRM_NEW_STAGE_ID=1
ODOO_ELV_CRM_TEAM_ID=6
ODOO_ELV_COMPANY_ID=3
