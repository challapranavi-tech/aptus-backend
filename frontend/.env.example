# ─── Next.js public vars (safe in the browser bundle) ──────────────────────────
# Local default when unset: http://localhost:3001
#
# Vercel Production / Preview (REQUIRED — missing or localhost → pages error/404):
#   APTUS_API_URL=https://your-backend.vercel.app
#   NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
#   NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app
# Do NOT set these to Odoo (.../odoo/website). That is the admin UI, not the API.
#
# APTUS_API_URL=http://localhost:3001

# Browser-reachable backend URL (client-side form submissions only).
# security: this must be a public API base — never put Odoo/SMTP secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Odoo image host for next/image (hostname only, no protocol).
# Staging example: aptusinfotech-staging-35193445.dev.odoo.com
ODOO_IMAGE_HOST=your-odoo-instance.odoo.com

# ─── Server-only (frontend /api/revalidate) ───────────────────────────────────
# Must match backend ODOO_REVALIDATE_TOKEN. Never prefix with NEXT_PUBLIC_.
# Generate: openssl rand -hex 32
ODOO_REVALIDATE_TOKEN=

# Shared rate-limit store (same Upstash Redis as backend). Needed so
# /api/revalidate limits are consistent across Vercel instances.
# Also used by the Customer Portal (OTP, refresh tokens, rate limits).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Server-side CMS fetch base (RSC / generateStaticParams). Not exposed to browser
# unless you also set NEXT_PUBLIC_API_URL. Prefer APTUS_API_URL for server only.
# APTUS_API_URL=http://localhost:3001

# ─── Customer Portal (server-only — never NEXT_PUBLIC_) ───────────────────────
# Portal Odoo uses JSON-2 Bearer API. Same instance as backend is fine.
# Portal Odoo uses JSON-RPC (same as backend). ODOO_BASE_URL preferred; ODOO_URL is a fallback.
# ODOO_BASE_URL=https://your-odoo.example.com
# ODOO_URL=https://your-odoo.example.com
# ODOO_DB=your_database
# ODOO_USER=api-user@example.com
# ODOO_API_KEY=
#
# Portal partner fields (Char on res.partner) — create once on staging:
#   cd backend && node --env-file=.env.local scripts/ensure-portal-partner-fields.mjs
# Or Odoo Studio: x_portal_password_hash, x_portal_account_id, x_portal_status,
# x_portal_created_at, x_portal_last_login.
#
# License delivery fields on sale.order.line (Odoo Studio Char):
# ODOO_LICENSE_FIELD=x_studio_line_serial_number
# ODOO_DOWNLOAD_URL_FIELD=x_studio_download_url
# PORTAL_BASE_URL=https://aptusinfotech.com

# RSA JWT key pair (required in production). Dev auto-generates under .data/
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ACCESS_EXPIRES_SEC=900
# JWT_REFRESH_EXPIRES_SEC=604800

# PII field encryption (≥32 chars). Required in production.
# PII_ENCRYPTION_KEY=

# SMTP for OTP / order mail (fallback when Resend is unset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Aptus Infotech <no-reply@aptusinfotech.com>
ORDER_NOTIFICATION_EMAIL=it-sales@aptusinfotech.com
# SOFTWARE_SALES_EMAIL=it-sales@aptusinfotech.com
# BACKEND_TEAM_EMAIL=it-sales@aptusinfotech.com

# Resend (preferred for portal OTP / lifecycle mail — same key as backend contact/quote)
# RESEND_API_KEY=re_xxxxxxxxx
# FROM_EMAIL=Aptus Infotech <no-reply@aptusinfotech.com>

# Stripe (optional — omit or leave secretKey as "sk_test_placeholder*" to disable
# card payments; portal falls back to bank transfer). Never NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Opt-in fixed OTP for local UI testing without mail. Leave unset to send real codes.
# OTP_USE_TEST_CODE=true
# OTP_TEST_CODE=0000
# AUTH_DEMO_MODE=
# Bank transfer details shown in the portal checkout UI.
# Defaults to the Aptus Bank Muscat account when unset; override here if needed.
# BANK_TRANSFER_COMPANY_NAME=ORIENTAL ORX INTER (APTUS INFOTECH)
# BANK_TRANSFER_BANK_NAME=Bank Muscat
# BANK_TRANSFER_ACCOUNT_NAME=ORIENTAL ORX INTER (APTUS INFOTECH)
# BANK_TRANSFER_ACCOUNT_NUMBER=0342-00229626-0015
# BANK_TRANSFER_CURRENCY=OMR
# BANK_TRANSFER_SWIFT=BMUSOMRXXXX
# BANK_TRANSFER_BRANCH=MBD South, Ruwi, Sultanate of Oman
# BANK_TRANSFER_IBAN=

# Comma-separated admin emails for /api/admin/*
# ADMIN_EMAILS=

# Bearer token for scheduled jobs (e.g. abandoned-cart reminders via /api/cron/cart-reminders)
# CRON_SECRET=

# RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# Optional salt for hashing IPs into rate-limit bucket keys. Falls back to
# JWT_SECRET, then PII_ENCRYPTION_KEY, then a fixed constant if all are unset.
# RATE_LIMIT_IP_SALT=
