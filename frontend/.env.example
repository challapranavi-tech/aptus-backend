# ─── Next.js public vars (safe in the browser bundle) ──────────────────────────
# Local default when unset: http://localhost:3001
#
# Vercel Production / Preview (REQUIRED — missing or localhost → pages error/404):
#   APTUS_API_URL=https://your-backend.vercel.app
#   NEXT_PUBLIC_API_URL=https://your-backend.vercel.app
#   NEXT_PUBLIC_SITE_URL=https://your-frontend.vercel.app
# Do NOT set these to Odoo (.../odoo/website). That is the admin UI, not the API.
#
# APTUS_API_URL=http://localhost:3001

# Browser-reachable backend URL (client-side form submissions only).
# security: this must be a public API base — never put Odoo/SMTP secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Odoo image host for next/image (hostname only, no protocol).
# Staging example: aptusinfotech-staging-35193445.dev.odoo.com
ODOO_IMAGE_HOST=your-odoo-instance.odoo.com

# ─── Server-only (frontend /api/revalidate) ───────────────────────────────────
# Must match backend ODOO_REVALIDATE_TOKEN. Never prefix with NEXT_PUBLIC_.
# Generate: openssl rand -hex 32
ODOO_REVALIDATE_TOKEN=

# Server-side CMS fetch base (RSC / generateStaticParams). Not exposed to browser
# unless you also set NEXT_PUBLIC_API_URL. Prefer APTUS_API_URL for server only.
# APTUS_API_URL=http://localhost:3001
