# ─── Backend API ────────────────────────────────────────────────────────────────
# Required on Vercel/Netlify production builds (set to deployed backend URL).
# Omit for local `next build` without backend — pages render at request time.
# Local dev default when unset: http://localhost:3001
# APTUS_API_URL=http://localhost:3001

# ─── Next.js public vars ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Odoo image host for next/image (hostname only, no protocol)
ODOO_IMAGE_HOST=aptusinfotech-staging-33910464.dev.odoo.com
